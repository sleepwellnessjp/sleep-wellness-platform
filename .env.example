# OpenAI（睡眠分析・SOXAI画像抽出に必須）
OPENAI_API_KEY=

# Supabase — Project Settings → API から取得
# 未設定の場合はデモモード（localStorage）で動作します
NEXT_PUBLIC_SUPABASE_URL=

# 公開キー（どちらか一方を設定）
# Next.js 16 / Supabase 公式推奨名:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 従来名（後方互換。上記が未設定の場合に使用）:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 注意: service_role キーは絶対に NEXT_PUBLIC_* やブラウザに含めないでください
# 注意: OPENAI_API_KEY が未設定だと /api/extract・/api/analyze は失敗します
